# Copy this to .env and fill in what you have.

PORT=4000

# Which LLM synthesizes the thesis card: "gemini" (default, free), "anthropic", or "qwen"
LLM_PROVIDER=gemini

# Needed if LLM_PROVIDER=gemini — free, no credit card: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Needed if LLM_PROVIDER=anthropic — https://platform.claude.com

# Needed if LLM_PROVIDER=qwen — from the hackathon's Qwen subsidy
# (first 300 KYC'd teams get $30 in credit; see the handbook for how to claim it)
BITGET_QWEN_API_KEY=
